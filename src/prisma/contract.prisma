// use prisma-8

model ShopSettings {
  id String @id
  short Int
  long Int
  pixRate Int
  cardRate Int
}

model ShirtOrder {
  id String @id
  email String
  customer String
  phone String
  items String
  total Int
  method String
  status String
  paymentId String?
  createdAt TimestamptzString @default(now())
}

model ShirtNumber {
  number Int @id
  orderId String
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  posts     Post[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
